{
  "manifest_version": 3,
  "name": "Studio Chat Dispatcher",
  "description": "A rolling pool of ten chats with completion and verified merge gates.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:8794/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "Open Studio Chat Dispatcher" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
