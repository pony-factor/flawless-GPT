{
  "manifest_version": 3,
  "name": "Flawless ChatGPT",
  "version": "1.7.5",
  "description": "Adds a personalized GitHub repository dashboard and optional ChatGPT interface tweaks.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contentSettings",
    "webNavigation",
    "identity",
    "clipboardRead",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*",
    "https://api.github.com/*",
    "https://avatars.githubusercontent.com/*",
    "https://github.com/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "background": {
    "service_worker": "js/core/background.js"
  },
  "action": {
    "default_title": "Flawless ChatGPT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "js/sidebar/sidebar-loading-background.js",
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "js/links/clipboard-utm-sanitizer.js",
        "js/links/citation-links-main.js",
        "js/links/image-recovery-main.js",
        "js/sidebar/sidebar-chat-dates-main.js",
        "js/core/chatgpt-route-events.js",
        "vendor/showdown.min.js",
        "vendor/purify.min.js",
        "js/chat/missing-response-recovery.js",
        "js/chat/refresh-view.js",
        "js/sidebar/sidebar-tab-state.js",
        "js/research/deep-research-usage.js",
        "js/settings/chatgpt-personalization-api.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "css/sidebar-loading-background.css",
        "css/work-mode.css",
        "css/disable-manual-web-search.css",
        "css/external-links.css",
        "css/compact-header.css",
        "css/flawless-corner.css",
        "css/chat-display.css",
        "css/missing-response-recovery.css",
        "css/refresh-view.css",
        "css/pony-error-page.css",
        "css/worked-duration.css",
        "css/composer-colors.css",
        "css/file-drop.css",
        "css/sidebar-chat-dates.css",
        "css/styles.css",
        "css/hide-dictation.css",
        "css/owner-grid.css",
        "css/private-repository-lock.css",
        "css/inline-toolbar-search.css",
        "css/repository-fast-ui.css"
      ],
      "js": [
        "js/core/extension-context.js",
        "js/chat/flawless-corner.js",
        "js/chat/pony-error-page.js",
        "js/settings/web-commit-guidance-sync.js",
        "js/chat/compact-header.js",
        "js/games/2048-keyboard.js",
        "js/sidebar/collapse-sidebar.js",
        "js/sidebar/sidebar-chat-dates.js",
        "js/dashboard/dashboard-visibility.js",
        "js/chat/disable-work-mode.js",
        "js/chat/disable-manual-web-search.js",
        "js/chat/chat-display.js",
        "js/links/unavailable-images.js",
        "js/chat/worked-duration.js",
        "js/chat/hide-share-label.js",
        "js/composer/composer-placeholder.js",
        "js/composer/composer-colors.js",
        "js/chat/force-high-thinking.js",
        "js/composer/autofocus-composer.js",
        "js/composer/preserve-scroll-on-send.js",
        "js/chat/hide-background-completion-notifications.js",
        "js/chat/hide-usage-card.js",
        "js/chat/hide-upgrade-promotions.js",
        "js/chat/hide-scheduled-recommendations.js",
        "js/links/external-links.js",
        "js/research/research-report-host.js",
        "js/research/research-import-dialog.js",
        "js/research/research-launcher.js",
        "js/research/research-manual-import.js",
        "js/chat/hide-cookie-preferences.js",
        "js/chat/chatgpt-disclaimer.js",
        "js/chat/block-voice-prompts.js",
        "js/links/clipboard-utm-preference.js",
        "js/dashboard/avatar-cache-ui.js",
        "js/dashboard/repository-fast-ui.js",
        "js/dashboard/owner-grid.js",
        "js/dashboard/repository-search-shortcut.js",
        "js/dashboard/dashboard-colors.js",
        "js/dashboard/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "css/2048.css",
        "css/youtube-search.css",
        "css/wooten-link-zipp-placeholder.css",
        "css/spellcheck-launcher.css",
        "css/clipboard-send.css",
        "css/temporary-chat-inline.css",
        "css/top-hat-send-button.css",
        "css/message-queue.css",
        "css/pinned-issues.css",
        "css/highlighted-pages.css",
        "css/deep-research-tracker.css"
      ],
      "js": [
        "js/launchers/youtube-search.js",
        "js/launchers/wooten-link-zipp-placeholder.js",
        "js/launchers/spellcheck-launcher.js",
        "js/research/deep-research-spellcheck.js",
        "js/games/2048.js",
        "js/composer/clipboard-send.js",
        "js/composer/message-queue.js",
        "js/composer/file-drop.js",
        "js/composer/temporary-chat-inline.js",
        "js/dashboard/pinned-issues-model.js",
        "js/dashboard/pinned-issues.js",
        "js/dashboard/highlighted-pages.js",
        "js/research/deep-research-tracker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.web-sandbox.oaiusercontent.com/*"
      ],
      "js": [
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "js/research/research-import-dialog.js",
        "js/research/research-publisher.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": [
        "js/github/github-empty-about.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "link-preview.html",
        "artwork/spellcheck-only.png",
        "artwork/calligraphy-initials.png",
        "artwork/research-telescope.png",
        "artwork/squeaky-belle-full.webp",
        "artwork/squeaky-belle-full.gif",
        "artwork/searching-complete.png"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
